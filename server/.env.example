# Only placeholders. Supply generated secrets through your development environment.
CRM_DB_URL=jdbc:postgresql://localhost:5432/crm?sslmode=require
CRM_DB_USER=crm_runtime
CRM_DB_PASSWORD=GENERATED_RUNTIME_PASSWORD
CRM_MIGRATION_DB_USER=crm_migrator
CRM_MIGRATION_DB_PASSWORD=GENERATED_MIGRATOR_PASSWORD
CRM_STAGE=development
CRM_COOKIE_SECURE=true
CRM_ALLOWED_ORIGINS=https://YOUR_TEST_DOMAIN
CRM_SEED_ENABLED=false
CRM_REMINDER_SCHEDULE_ENABLED=true
CRM_PUBLIC_BASE_URL=https://YOUR_TEST_DOMAIN
CRM_S3_ENDPOINT=https://YOUR_PRIVATE_S3_ENDPOINT
CRM_S3_BUCKET=YOUR_PRIVATE_BUCKET
CRM_S3_REGION=auto
CRM_S3_ACCESS_KEY=GENERATED_STORAGE_ACCESS_KEY
CRM_S3_SECRET_KEY=GENERATED_STORAGE_SECRET_KEY
CRM_S3_PATH_STYLE=false
CRM_OBJECT_PREFIX=preview
# Blank host/from keeps password recovery disabled. Set verified sender and TLS.
CRM_SMTP_HOST=
CRM_SMTP_PORT=587
CRM_SMTP_USER=
CRM_SMTP_PASSWORD=
CRM_SMTP_FROM=
CRM_SMTP_TLS=true
CRM_SMTP_SSL=false
# Enable only in an isolated development/test environment.
# CRM_SEED_PASSWORD=GENERATED_TEST_LOGIN_PASSWORD
